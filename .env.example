# ─── SUPABASE ──────────────────────────────────────────────
# Required for database, storage, and realtime features.
# Create a project at https://supabase.com and copy your keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only service role key for admin API routes (bucket creation, etc.).
# DO NOT prefix with NEXT_PUBLIC_ — never expose to the client.
# Find this in Supabase Dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LOCAL TEST MODE ──────────────────────────────────────
# Set to "true" to run without Supabase/Telegram/Gemini.
# All data is stored in localStorage with realistic seed data.
# Shows a yellow banner in the admin panel indicating test mode.
# NEXT_PUBLIC_TEST_MODE=true

# ─── TELEGRAM STORAGE ─────────────────────────────────────-
# Required for storing large files (audio, video, templates).
# Create a bot at https://t.me/BotFather and get your token.
# Create a private Telegram group/channel and add your bot as admin.
# The bot token and group ID are used server-side only.
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_STORAGE_CHAT_ID=-1234567890

# ─── GEMINI AI ─────────────────────────────────────────────
# Required for the AI Assistant feature.
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── ADMIN DASHBOARD ───────────────────────────────────────
# Server-side password for the admin dashboard login page.
# The password is sent via POST to /api/admin-verify, never exposed client-side.
# ADMIN_PASSWORD is required — maps to the "admin" role.
# SUPER_ADMIN_PASSWORD and VIEWER_PASSWORD are optional:
#   SUPER_ADMIN_PASSWORD → "super_admin" role (full access, including setup-storage)
#   ADMIN_PASSWORD       → "admin" role (can view and manage campaigns, payments, reviews)
#   VIEWER_PASSWORD      → "viewer" role (read-only: can view dashboards but not take action)
ADMIN_PASSWORD=change-me-to-a-strong-password
# SUPER_ADMIN_PASSWORD=change-me-to-a-stronger-password
# VIEWER_PASSWORD=change-me-to-a-readonly-password

# ─── WHATSAPP SUPPORT ──────────────────────────────────────
# Phone number for the WhatsApp support button across the site.
# Optional — falls back to a default if not set.
NEXT_PUBLIC_WHATSAPP_PHONE=233556513157

# ─── MOMO PAYMENT NUMBER ───────────────────────────────────
# Displayed on the payment page for manual MoMo transfers.
# Optional — falls back to a default if not set.
NEXT_PUBLIC_MOMO_NUMBER=0552 783 151

# ─── PAYMENT (optional) ───────────────────────────────────-
# Payment provider keys will go here when integrated.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
